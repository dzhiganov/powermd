# GitHub App OAuth — see README.md "GitHub sync" section for the exact
# GitHub App settings (callback URL, permissions) these pair with.

# Server-only (read by api/github/token.ts, api/github/refresh.ts, and
# api/github/revoke.ts via process.env — never bundled into client code,
# never prefixed VITE_).
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=

# Public — bundled into the client (Vite only exposes VITE_-prefixed vars).
# VITE_GITHUB_APP_CLIENT_ID should be the same value as GITHUB_APP_CLIENT_ID
# above; a GitHub App's client id is not a secret (it's visible in the
# authorize URL regardless).
VITE_GITHUB_APP_CLIENT_ID=
# The App's slug (from its public URL, github.com/apps/<slug>) — used ONLY
# to build the "install this app on a repository" link. Optional: if unset,
# that link falls back to GitHub's generic settings/installations page.
# NOTE: renaming the GitHub App changes its slug (its client id does not
# change) — update this after a rename, or the install link degrades to the
# generic fallback rather than 404ing. Nothing else in this app depends on
# the slug.
VITE_GITHUB_APP_SLUG=
