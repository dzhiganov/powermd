{
  "extends": "@vue/tsconfig/tsconfig.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.worker.tsbuildinfo",
    // Explicitly WebWorker only, not DOM: `self` here is a worker global
    // scope, not `Window`, and the two `lib`s can't coexist in one
    // program. This is why worker.ts is its own project instead of being
    // part of tsconfig.app.json (which sets `lib: [..., "DOM"]`) — see
    // that file's `exclude`.
    "lib": ["ES2023", "WebWorker"],
    "types": [],

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src/features/preview/lib/worker.ts"]
}
